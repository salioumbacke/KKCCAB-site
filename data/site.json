  "rubriquesActivitesInitialisees": true,
  "guideTitre": "Serigne Mahmadane Mbacké",
  "guideFonction": "Guide du Daara Khitmatoul Khadim CCAB",
  "guideTexte1": "Serigne Mahmadane Mbacke est le guide spirituel et l'encadreur du Daara Khitmatoul Khadim CCAB. Sa vie est un témoignage vivant de la tradition mouride : dévotion totale à Dieu, attachement indéfectible à l'enseignement de Serigne Touba et amour sincère pour ses disciples1.",
  "guideTexte2": "Sous sa conduite bienveillante, les membres du Daara apprennent à unir la prière et le travail, à réciter les Khassida avec cœur, et à vivre pleinement les préceptes de la Tariqa Mouridiyya.",
  "guideLignee1": "Fils de Serigne Abdou Ahad Mbacké",
  "guideLignee2": "Petit-fils de Serigne Touba Khadimou Rassoul (Cheikh Ahmadou Bamba Mbacké)",
  "guideVideoTitre": "s dane",
  "formationTitre": "Apprentissage du Dine & Taarikha Mouridiyya",
  "formationTexte": "Le Daara accorde une place centrale à l'éducation religieuse. Chaque membre est encouragé à approfondir sa connaissance de l'Islam et de la voie mouride initiée par Cheikh Ahmadou Bamba.",
  "formations": [
    {
      "id": "formation-coran",
      "titre": "Coran & Prière",
      "description": "Mémorisation des sourates, correction de la récitation et apprentissage des prières quotidiennes (Salat)."
    },
    {
      "id": "formation-khassida",
      "titre": "Khassida",
      "description": "Étude et récitation des poèmes spirituels de Cheikh Ahmadou Bamba : Jazboul Qouloub, Matlaboul Fawzayni..."
    },
    {
      "id": "formation-taarikha",
      "titre": "Taarikha Mouridiyya",
      "description": "Histoire de la Mouridiyya, biographie de Serigne Touba, principes fondateurs de la Tariqa."
    },
    {
      "id": "formation-sciences",
      "titre": "Sciences islamiques",
      "description": "Initiation à la jurisprudence islamique (Fiqh), aux hadiths du Prophète et aux écrits des saints."
    }
  ],
  "objectifs": [
    {
      "id": "objectif-1",
      "texte": "Augmenter significativement le nombre de membres et élargir notre réseau de jeunes mourides à travers Dakar et au-delà."
    },
    {
      "id": "objectif-2",
      "texte": "Construire ou acquérir un lieu de réunion permanent dédié aux séances de Khassida et à la formation religieuse."
    },
    {
      "id": "objectif-3",
      "texte": "Développer le Siar annuel à Diatt Mbay pour en faire un événement de référence dans la région."
    },
    {
      "id": "objectif-4",
      "texte": "Renforcer la Journée Khassida à Dakar et l'ouvrir à l'ensemble de la communauté mouride nationale."
    },
    {
      "id": "objectif-5",
      "texte": "Mettre en place un programme de formation structuré pour chaque membre."
    }
  ],
